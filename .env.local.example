# ===== Supabase Configuration =====
# Copy this file to .env.local and fill in the values.
# Set up a project on supabase.com and retrieve these from Project Settings -> API.

# Supabase API URL (Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Key (Client API Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-Only Admin Key - KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=